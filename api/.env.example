# Salin menjadi .env lalu isi nilainya. Jangan pernah commit berkas .env.
PORT=3001

# Kosongkan dua variabel berikut bila ingin memakai data contoh dari
# src/data/palet.kurasi.json. Isi bila tabel palet di Supabase sudah siap.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Daftar origin yang diizinkan memanggil API, pisahkan dengan koma.
# Contoh: http://localhost:5173,https://chromavibe.vercel.app
CORS_ORIGIN=*
